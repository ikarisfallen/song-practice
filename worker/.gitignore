# Wrangler local state and credentials cache.
.wrangler/

# npm install artifacts (Wrangler is fine without them, but if you
# add deps later they shouldn't get committed).
node_modules/

# Local environment overrides — never commit secrets, even by
# accident. Production secrets live in Cloudflare via
# `wrangler secret put`, not in files.
.dev.vars
.env
.env.local
